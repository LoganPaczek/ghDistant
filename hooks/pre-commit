#!/bin/bash
# Hook pre-commit : ajoute au commit un fichier de suivi
# contenant "commit vérifié le <date et heure du jour>" si on répond 'y'.
#
# Installation : voir readme.txt (git config core.hooksPath hooks)

# Chemin relatif à la racine du dépôt où stocker le fichier de suivi.
SUIVI_PATH=suivi
SUIVI_FILE=$SUIVI_PATH/commitInfo.txt

read -p "Ajouter le fichier de suivi dans ce commit (y/[n]) ? " yn < /dev/tty
yn=${yn:-n}
case $yn in
    [Yy]* )
        mkdir -p "$SUIVI_PATH"
        echo "commit vérifié le $(date '+%d/%m/%Y %H:%M:%S')" > "$SUIVI_FILE"
        git add "$SUIVI_FILE"
        echo "-> $SUIVI_FILE ajouté au commit"
        exit 0;;
    [Nn]* )
        exit 0;;
esac
exit 0
